{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pustakaterbuka.org/schemas/provenance-line.schema.json",
  "title": "Harvester Provenance Line",
  "type": "object",
  "properties": {
    "source_001": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "harvested_at": {
      "type": "string",
      "format": "date-time"
    },
    "file": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "source_001",
    "source_url",
    "harvested_at",
    "file",
    "index"
  ],
  "additionalProperties": false
}
