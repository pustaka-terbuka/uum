{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9]{2,30}$": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string" },
        "type": { "type": "string", "enum": ["school", "university", "public", "special"] },
        "default_scheme": { "type": "string", "enum": ["LCC", "DDC"] },
        "contact": { "type": "string", "format": "email" },
        "logo": { "type": "string" },
        "opac_url": { "type": "string", "format": "uri" }
      },
      "required": ["name", "state", "type", "default_scheme"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
